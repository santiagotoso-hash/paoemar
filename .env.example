# Neon Postgres — https://neon.tech
# DATABASE_URL: la conexión CON pooler (hostname termina en "-pooler"), la usa la app en runtime.
# DIRECT_URL: la conexión SIN pooler, la usa Prisma solo para migraciones.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Clerk — https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Upstash Redis — https://upstash.com (usar la URL con protocolo redis:// o rediss://, no la REST URL)
UPSTASH_REDIS_URL="rediss://default:password@host:port"

# Emails separados por coma: si se registran sin rol asignado, quedan como
# "admin" automáticamente (útil para demos con clientes). Dejar vacío para
# desactivar y asignar roles siempre a mano desde el dashboard de Clerk.
ADMIN_AUTO_EMAILS="cliente@ejemplo.com,socio@ejemplo.com"

# Assina o cookie do atendente das mesas (PIN). Se ficar vazio, usa o CLERK_SECRET_KEY.
# Gere um valor aleatório (não deixe o texto de exemplo):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se mudar, os atendentes logados precisam digitar o PIN de novo.
ATENDENTE_SESSION_SECRET="uma-string-longa-e-aleatoria"

# Senha entre o servidor e o programa de impressão (pasta agente-impressao).
# O MESMO valor precisa estar no .env do agente. Gere como acima. Sem ela, a API
# /api/impressao responde 503 e nenhum ticket é impresso.
PRINT_AGENT_TOKEN="troque-por-um-token-longo-e-aleatorio"

# Contatos da página inicial pública (opcionais; sem eles usa os valores padrão do código).
# WhatsApp só com números, com código do país e DDD. Ex.: 5571999991778
# NEXT_PUBLIC_CONTATO_WHATSAPP="5571999991778"
# NEXT_PUBLIC_CONTATO_EMAIL="contato@seudominio.com"

# Focus NFe — https://focusnfe.com.br (emissão de NFC-e e NF-e). Token da conta, gerado no painel deles.
# Use o token de HOMOLOGAÇÃO nos testes e o de PRODUÇÃO só quando o contador liberar. Nunca comite o valor.
# FOCUSNFE_TOKEN=""
