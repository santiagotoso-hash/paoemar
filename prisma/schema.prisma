generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  icono     String?
  productos Producto[]
}

model Producto {
  id               String          @id @default(cuid())
  codigo           String          @unique
  nombre           String
  categoriaId      String
  precio           Decimal
  tipoUnidad       TipoUnidad      @default(UNIDAD)
  descripcion      String?
  stockActual      Decimal
  stockMinimo      Decimal         @default(5)
  imagenUrl        String?
  activo           Boolean         @default(true)
  categoria        Categoria       @relation(fields: [categoriaId], references: [id])
  ventaItems       VentaItem[]
  comandaItems     ComandaItem[]
  adicionais       Adicional[]
  gruposOpcion     GrupoOpcion[]
  /// Ficha técnica: se tiver linhas, a venda baixa os insumos e não usa stockActual.
  receita          ReceitaItem[]
  /// Pode ser pedido por encomenda (aparece na lista da tela de encomendas e vai para a Fábrica).
  encomendavel     Boolean         @default(false)
  /// Sai na impressora da cozinha (comanda impressa dos itens marcados).
  imprimirCozinha  Boolean         @default(false)
  /// Sai na impressora da produção (Fábrica), que é outra impressora.
  imprimirProducao Boolean         @default(false)
  encomendaItems   EncomendaItem[]
}

/// Pedido por encomenda: produzido na Fábrica para retirada numa data e hora combinadas.
model Encomenda {
  id            String          @id @default(cuid())
  codigo        String          @unique
  nombreCliente String
  telefone      String?
  retiradaEm    DateTime
  notas         String?
  estado        EstadoVenta     @default(RECIBIDO)
  creadaEn      DateTime        @default(now())
  /// Quando o estado mudou pela última vez.
  estadoDesde   DateTime        @default(now())
  emProducaoEm  DateTime?
  prontoEm      DateTime?
  entregueEm    DateTime?
  /// Cliente cadastrado (opcional: dá para encomendar só com um nome digitado).
  clienteId     String?
  cliente       Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  items         EncomendaItem[]
}

/// Cliente das encomendas (pousadas, mercados…).
model Cliente {
  id         String      @id @default(cuid())
  nombre     String
  endereco   String?
  telefone   String?
  email      String?
  cnpj       String?
  notas      String?
  criadoEm   DateTime    @default(now())
  encomendas Encomenda[]
}

model EncomendaItem {
  id          String    @id @default(cuid())
  encomendaId String
  productoId  String
  cantidad    Decimal
  notas       String?
  encomenda   Encomenda @relation(fields: [encomendaId], references: [id], onDelete: Cascade)
  producto    Producto  @relation(fields: [productoId], references: [id])
}

/// Grupo de escolha única ligado a um produto (ex.: recheio da tapioca).
model GrupoOpcion {
  id          String   @id @default(cuid())
  nombre      String
  productoId  String
  obligatorio Boolean  @default(true)
  orden       Int      @default(0)
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  opciones    Opcion[]
}

model Opcion {
  id      String      @id @default(cuid())
  nombre  String
  /// Valor somado ao preço base do produto.
  precio  Decimal     @default(0)
  orden   Int         @default(0)
  grupoId String
  grupo   GrupoOpcion @relation(fields: [grupoId], references: [id], onDelete: Cascade)
}

model Adicional {
  id        String     @id @default(cuid())
  nombre    String
  precio    Decimal
  productos Producto[]
}

model Comanda {
  id            String             @id @default(cuid())
  codigo        String
  nombreCliente String?
  estado        EstadoComanda      @default(ABIERTA)
  abiertaEn     DateTime           @default(now())
  cerradaEn     DateTime?
  tipo          TipoMesa           @default(NOMBRE)
  personas      Int?
  /// Taxa de serviço. As mesas abrem com true; as comandas da tela antiga ficam sem.
  servicio      Boolean            @default(false)
  atendenteId   String?
  atendente     Atendente?         @relation(fields: [atendenteId], references: [id])
  items         ComandaItem[]
  rondas        Ronda[]
  cancelamentos CancelamentoItem[]
  venta         Venta?
}

/// Atendente do salão: entra com PIN por cima da sessão Clerk do aparelho.
model Atendente {
  id                       String             @id @default(cuid())
  nombre                   String
  pinHash                  String
  activo                   Boolean            @default(true)
  /// Pode autorizar cancelamento de itens já lançados (com o próprio PIN).
  supervisor               Boolean            @default(false)
  creadoEn                 DateTime           @default(now())
  comandas                 Comanda[]
  rondas                   Ronda[]
  cancelamentosAutorizados CancelamentoItem[] @relation("CancelamentoSupervisor")
  cancelamentosPedidos     CancelamentoItem[] @relation("CancelamentoAtendente")
}

/// Registro (auditoria) de itens lançados que foram cancelados antes de fechar a conta.
/// Guarda cópia do nome/valor: o registro não muda se o produto mudar depois.
model CancelamentoItem {
  id             String    @id @default(cuid())
  comandaId      String
  rondaId        String?
  productoId     String
  productoNombre String
  detalhe        String?
  cantidad       Decimal
  valor          Decimal
  motivo         String
  supervisorId   String
  atendenteId    String
  criadoEm       DateTime  @default(now())
  comanda        Comanda   @relation(fields: [comandaId], references: [id])
  supervisor     Atendente @relation("CancelamentoSupervisor", fields: [supervisorId], references: [id])
  atendente      Atendente @relation("CancelamentoAtendente", fields: [atendenteId], references: [id])

  @@index([criadoEm])
}

/// Um envio de itens da mesa para a cozinha. Reaproveita os estados da cozinha.
model Ronda {
  id          String        @id @default(cuid())
  comandaId   String
  atendenteId String
  /// Chave de envio gerada no aparelho: evita rodada duplicada quando o envio é repetido.
  clave       String?       @unique
  creadaEn    DateTime      @default(now())
  estado      EstadoVenta   @default(RECIBIDO)
  /// Quando o estado mudou pela última vez (para detectar pedido parado).
  estadoDesde DateTime      @default(now())
  /// Linha do tempo na cozinha (lançado/recebido = creadaEn).
  emPreparoEm DateTime?
  prontoEm    DateTime?
  entregueEm  DateTime?
  comanda     Comanda       @relation(fields: [comandaId], references: [id])
  atendente   Atendente     @relation(fields: [atendenteId], references: [id])
  items       ComandaItem[]
}

model ComandaItem {
  id         String                 @id @default(cuid())
  comandaId  String
  productoId String
  cantidad   Decimal
  precioUnit Decimal
  notas      String?
  /// Opção escolhida no grupo obrigatório (o preço já vem somado em precioUnit).
  opcion     String?
  rondaId    String?
  comanda    Comanda                @relation(fields: [comandaId], references: [id])
  producto   Producto               @relation(fields: [productoId], references: [id])
  ronda      Ronda?                 @relation(fields: [rondaId], references: [id])
  adicionais ComandaItemAdicional[]
}

model ComandaItemAdicional {
  id            String      @id @default(cuid())
  comandaItemId String
  nombre        String
  precio        Decimal
  comandaItem   ComandaItem @relation(fields: [comandaItemId], references: [id], onDelete: Cascade)
}

model Venta {
  id            String          @id @default(cuid())
  codigo        String          @unique
  comandaId     String?         @unique
  origen        OrigenVenta
  nombreCliente String          @default("Mostrador")
  subtotal      Decimal
  descuento     Decimal         @default(0)
  /// Taxa de serviço (gorjeta), separada do consumo. total = subtotal - descuento + servicio.
  servicio      Decimal         @default(0)
  total         Decimal
  metodoPago    MetodoPago
  bandeira      BandeiraCartao?
  estado        EstadoVenta     @default(RECIBIDO)
  cajaSesionId  String
  operadorId    String
  comanda       Comanda?        @relation(fields: [comandaId], references: [id])
  cajaSesion    CajaSesion      @relation(fields: [cajaSesionId], references: [id])
  items         VentaItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model VentaItem {
  id         String               @id @default(cuid())
  ventaId    String
  productoId String
  cantidad   Decimal
  precioUnit Decimal
  total      Decimal
  notas      String?
  venta      Venta                @relation(fields: [ventaId], references: [id])
  producto   Producto             @relation(fields: [productoId], references: [id])
  adicionais VentaItemAdicional[]
}

model VentaItemAdicional {
  id          String    @id @default(cuid())
  ventaItemId String
  nombre      String
  precio      Decimal
  ventaItem   VentaItem @relation(fields: [ventaItemId], references: [id], onDelete: Cascade)
}

model CajaSesion {
  id           String           @id @default(cuid())
  abierta      Boolean          @default(true)
  fondoInicial Decimal
  operadorId   String
  abiertaEn    DateTime         @default(now())
  cerradaEn    DateTime?
  movimientos  CajaMovimiento[]
  ventas       Venta[]
}

model CajaMovimiento {
  id           String         @id @default(cuid())
  cajaSesionId String
  tipo         TipoMovimiento
  monto        Decimal
  descripcion  String?
  cajaSesion   CajaSesion     @relation(fields: [cajaSesionId], references: [id])
  createdAt    DateTime       @default(now())
}

/// Matéria-prima (insumo): estoque próprio, separado do `stockActual` dos produtos vendidos.
model Insumo {
  id            String             @id @default(cuid())
  nome          String             @unique
  unidade       UnidadeInsumo      @default(UN)
  /// Pode ficar negativo: a venda baixa pela ficha técnica sem bloquear (o cliente já consumiu).
  estoqueAtual  Decimal            @default(0)
  estoqueMinimo Decimal            @default(0)
  /// Custo médio ponderado por unidade; atualizado a cada entrada com custo.
  custoMedio    Decimal            @default(0)
  ativo         Boolean            @default(true)
  criadoEm      DateTime           @default(now())
  receita       ReceitaItem[]
  movimentos    MovimentoEstoque[]
  compraItens   CompraItem[]
  codigos       FornecedorInsumo[]
}

/// Linha da ficha técnica: quanto do insumo vai em 1 unidade (ou 1 kg) do produto.
model ReceitaItem {
  id         String   @id @default(cuid())
  produtoId  String
  insumoId   String
  quantidade Decimal
  produto    Producto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo     Insumo   @relation(fields: [insumoId], references: [id])

  @@unique([produtoId, insumoId])
}

model Fornecedor {
  id       String             @id @default(cuid())
  nome     String
  /// Só dígitos. Usado para reconhecer o fornecedor ao importar o XML da NF.
  cnpj     String?            @unique
  telefone String?
  ativo    Boolean            @default(true)
  criadoEm DateTime           @default(now())
  compras  Compra[]
  codigos  FornecedorInsumo[]
}

/// Código do item no cadastro do fornecedor -> insumo. Casa os itens nas próximas importações de XML.
model FornecedorInsumo {
  id           String     @id @default(cuid())
  fornecedorId String
  insumoId     String
  codigo       String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  insumo       Insumo     @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, codigo])
}

/// NF de compra (entrada de mercadoria). Cada item gera um movimento ENTRADA_COMPRA.
model Compra {
  id           String             @id @default(cuid())
  fornecedorId String
  numero       String
  serie        String             @default("")
  /// Chave de acesso de 44 dígitos (opcional na digitação; vem do XML).
  chaveAcesso  String?            @unique
  emitidaEm    DateTime
  /// Soma dos itens (já com frete/desconto por item, quando vem do XML).
  total        Decimal
  observacao   String?
  origem       OrigemCompra       @default(MANUAL)
  criadoEm     DateTime           @default(now())
  fornecedor   Fornecedor         @relation(fields: [fornecedorId], references: [id])
  itens        CompraItem[]
  movimentos   MovimentoEstoque[]

  @@unique([fornecedorId, numero, serie])
  @@index([emitidaEm])
}

model CompraItem {
  id         String  @id @default(cuid())
  compraId   String
  insumoId   String
  /// Descrição como veio na NF (o insumo pode ter outro nome).
  descricao  String
  /// Na unidade do insumo.
  quantidade Decimal
  custoUnit  Decimal
  total      Decimal
  compra     Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumo     Insumo  @relation(fields: [insumoId], references: [id])
}

/// Histórico de tudo que mexe no estoque de insumos. `quantidade` leva sinal (+ entra, - sai).
model MovimentoEstoque {
  id         String               @id @default(cuid())
  insumoId   String
  tipo       TipoMovimentoEstoque
  quantidade Decimal
  custoUnit  Decimal?
  /// Saldo do insumo logo depois deste movimento.
  saldoApos  Decimal
  motivo     String?
  compraId   String?
  vendaId    String?
  criadoEm   DateTime             @default(now())
  insumo     Insumo               @relation(fields: [insumoId], references: [id])
  compra     Compra?              @relation(fields: [compraId], references: [id])

  @@index([insumoId, criadoEm])
  @@index([criadoEm])
}

enum UnidadeInsumo {
  UN
  KG
  G
  L
  ML
}

enum OrigemCompra {
  MANUAL
  XML
}

enum TipoMovimentoEstoque {
  ENTRADA_COMPRA
  ENTRADA_MANUAL
  AJUSTE
  PERDA
  SAIDA_VENDA
}

enum TipoUnidad {
  UNIDAD
  KG
}

enum EstadoComanda {
  ABIERTA
  CERRADA
}

enum TipoMesa {
  NUMERO
  NOMBRE
}

enum OrigenVenta {
  MOSTRADOR
  COMANDA
}

enum EstadoVenta {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  /// Legado: não aparece mais na tela (substituído por PIX); fica para vendas antigas.
  TRANSFERENCIA
  PIX
}

/// Bandeira do cartão (obrigatória quando o pagamento é crédito ou débito).
enum BandeiraCartao {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OUTRA
}

enum TipoMovimiento {
  SANGRIA
  SUMINISTRO
}

/// Onde o ticket sai: a impressora da cozinha ou a da produção (Fábrica).
enum DestinoImpressao {
  COZINHA
  PRODUCAO
}

enum ConexaoImpressora {
  REDE
  USB
  BLUETOOTH
}

/// Configuração de uma impressora de tickets (uma por destino).
model Impressora {
  id           String            @id @default(cuid())
  destino      DestinoImpressao  @unique
  nome         String
  ativa        Boolean           @default(true)
  conexao      ConexaoImpressora @default(REDE)
  /// IP ou nome da impressora. Só identifica o aparelho: no modo navegador a impressora é escolhida no diálogo do sistema.
  endereco     String?
  porta        Int?
  /// Largura do papel em mm (58 ou 80).
  larguraMm    Int               @default(80)
  copias       Int               @default(1)
  atualizadaEm DateTime          @updatedAt
}

/// Fila de tickets: o programa da loja (agente-impressao) busca os pendentes e imprime.
model TicketImpressao {
  id          String           @id @default(cuid())
  /// Evita ticket em duplicidade para o mesmo pedido e destino. Ex.: "ronda:<id>:COZINHA".
  chave       String           @unique
  destino     DestinoImpressao
  titulo      String
  linhas      String[]
  larguraMm   Int
  copias      Int
  criadoEm    DateTime         @default(now())
  /// Entregue ao agente e ainda sem confirmação (tenta de novo se passar do prazo).
  reservadoEm DateTime?
  impressoEm  DateTime?
  tentativas  Int              @default(0)
  erro        String?

  @@index([destino, impressoEm])
}
