generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  icono     String?
  productos Producto[]
}

model Producto {
  id           String        @id @default(cuid())
  codigo       String        @unique
  nombre       String
  categoriaId  String
  precio       Decimal
  tipoUnidad   TipoUnidad    @default(UNIDAD)
  descripcion  String?
  stockActual  Decimal
  stockMinimo  Decimal       @default(5)
  imagenUrl    String?
  activo       Boolean       @default(true)
  categoria    Categoria     @relation(fields: [categoriaId], references: [id])
  ventaItems   VentaItem[]
  comandaItems ComandaItem[]
  adicionais   Adicional[]
  gruposOpcion GrupoOpcion[]
}

/// Grupo de escolha única ligado a um produto (ex.: recheio da tapioca).
model GrupoOpcion {
  id          String   @id @default(cuid())
  nombre      String
  productoId  String
  obligatorio Boolean  @default(true)
  orden       Int      @default(0)
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  opciones    Opcion[]
}

model Opcion {
  id      String      @id @default(cuid())
  nombre  String
  /// Valor somado ao preço base do produto.
  precio  Decimal     @default(0)
  orden   Int         @default(0)
  grupoId String
  grupo   GrupoOpcion @relation(fields: [grupoId], references: [id], onDelete: Cascade)
}

model Adicional {
  id        String     @id @default(cuid())
  nombre    String
  precio    Decimal
  productos Producto[]
}

model Comanda {
  id            String        @id @default(cuid())
  codigo        String
  nombreCliente String?
  estado        EstadoComanda @default(ABIERTA)
  abiertaEn     DateTime      @default(now())
  cerradaEn     DateTime?
  tipo          TipoMesa      @default(NOMBRE)
  personas      Int?
  servicio      Boolean       @default(true)
  atendenteId   String?
  atendente     Atendente?    @relation(fields: [atendenteId], references: [id])
  items         ComandaItem[]
  rondas        Ronda[]
  venta         Venta?
}

/// Atendente do salão: entra com PIN por cima da sessão Clerk do aparelho.
model Atendente {
  id       String    @id @default(cuid())
  nombre   String
  pinHash  String
  activo   Boolean   @default(true)
  creadoEn DateTime  @default(now())
  comandas Comanda[]
  rondas   Ronda[]
}

/// Um envio de itens da mesa para a cozinha. Reaproveita os estados da cozinha.
model Ronda {
  id          String        @id @default(cuid())
  comandaId   String
  atendenteId String
  creadaEn    DateTime      @default(now())
  estado      EstadoVenta   @default(RECIBIDO)
  comanda     Comanda       @relation(fields: [comandaId], references: [id])
  atendente   Atendente     @relation(fields: [atendenteId], references: [id])
  items       ComandaItem[]
}

model ComandaItem {
  id         String                 @id @default(cuid())
  comandaId  String
  productoId String
  cantidad   Decimal
  precioUnit Decimal
  notas      String?
  /// Opção escolhida no grupo obrigatório (o preço já vem somado em precioUnit).
  opcion     String?
  rondaId    String?
  comanda    Comanda                @relation(fields: [comandaId], references: [id])
  producto   Producto               @relation(fields: [productoId], references: [id])
  ronda      Ronda?                 @relation(fields: [rondaId], references: [id])
  adicionais ComandaItemAdicional[]
}

model ComandaItemAdicional {
  id            String      @id @default(cuid())
  comandaItemId String
  nombre        String
  precio        Decimal
  comandaItem   ComandaItem @relation(fields: [comandaItemId], references: [id], onDelete: Cascade)
}

model Venta {
  id            String      @id @default(cuid())
  codigo        String      @unique
  comandaId     String?     @unique
  origen        OrigenVenta
  nombreCliente String      @default("Mostrador")
  subtotal      Decimal
  descuento     Decimal     @default(0)
  /// Taxa de serviço (gorjeta), separada do consumo. total = subtotal - descuento + servicio.
  servicio      Decimal     @default(0)
  total         Decimal
  metodoPago    MetodoPago
  estado        EstadoVenta @default(RECIBIDO)
  cajaSesionId  String
  operadorId    String
  comanda       Comanda?    @relation(fields: [comandaId], references: [id])
  cajaSesion    CajaSesion  @relation(fields: [cajaSesionId], references: [id])
  items         VentaItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model VentaItem {
  id         String               @id @default(cuid())
  ventaId    String
  productoId String
  cantidad   Decimal
  precioUnit Decimal
  total      Decimal
  notas      String?
  venta      Venta                @relation(fields: [ventaId], references: [id])
  producto   Producto             @relation(fields: [productoId], references: [id])
  adicionais VentaItemAdicional[]
}

model VentaItemAdicional {
  id          String    @id @default(cuid())
  ventaItemId String
  nombre      String
  precio      Decimal
  ventaItem   VentaItem @relation(fields: [ventaItemId], references: [id], onDelete: Cascade)
}

model CajaSesion {
  id           String           @id @default(cuid())
  abierta      Boolean          @default(true)
  fondoInicial Decimal
  operadorId   String
  abiertaEn    DateTime         @default(now())
  cerradaEn    DateTime?
  movimientos  CajaMovimiento[]
  ventas       Venta[]
}

model CajaMovimiento {
  id           String         @id @default(cuid())
  cajaSesionId String
  tipo         TipoMovimiento
  monto        Decimal
  descripcion  String?
  cajaSesion   CajaSesion     @relation(fields: [cajaSesionId], references: [id])
  createdAt    DateTime       @default(now())
}

enum TipoUnidad {
  UNIDAD
  KG
}

enum EstadoComanda {
  ABIERTA
  CERRADA
}

enum TipoMesa {
  NUMERO
  NOMBRE
}

enum OrigenVenta {
  MOSTRADOR
  COMANDA
}

enum EstadoVenta {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
}

enum TipoMovimiento {
  SANGRIA
  SUMINISTRO
}
