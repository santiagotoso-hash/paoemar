# Endereço do sistema (sem barra no final)
APP_URL=https://SEU-ENDERECO.vercel.app

# Token secreto: o MESMO valor da variável PRINT_AGENT_TOKEN configurada no servidor (Vercel)
PRINT_AGENT_TOKEN=troque-por-um-token-longo

# Quais impressoras este computador atende (separe por vírgula): COZINHA, PRODUCAO, CAIXA
DESTINOS=COZINHA,PRODUCAO,CAIXA

# Intervalo de consulta ao servidor, em milissegundos
INTERVALO_MS=2000

# Opcional: só se o endereço acima der "Protected by Vercel Authentication".
# Código de Settings → Deployment Protection → Protection Bypass for Automation (na Vercel).
VERCEL_BYPASS=

# 1 = só mostra o ticket na tela, sem imprimir (para testar)
SIMULAR=0
